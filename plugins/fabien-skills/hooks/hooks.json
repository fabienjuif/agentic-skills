{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook || python \"${CLAUDE_PLUGIN_ROOT}/skills/eta/eta.py\" hook"
          }
        ]
      }
    ]
  }
}
